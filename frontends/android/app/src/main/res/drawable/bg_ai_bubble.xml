<?xml version="1.0" encoding="utf-8"?>
<!-- AI helper bubble — contextual onboarding hint shown once after creating a
     blank book. Matches web .toolbar__ai-bubble: surface fill, outline stroke,
     8dp corners, small upward-pointing tail via a separate layer-list. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurface" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
    <corners android:radius="8dp" />
</shape>
