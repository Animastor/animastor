<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceDim">

    <!-- Media Viewport — cinema screen -->
    <FrameLayout
        android:id="@+id/mediaContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceDim"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Curtains — idle/cinematic waiting state -->
        <ImageView
            android:id="@+id/curtainsImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/coverImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/resultImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:visibility="invisible" />

        <SurfaceView
            android:id="@+id/videoSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <!-- Dark scrim overlay for cinema letterbox effect -->
        <View
            android:id="@+id/previewOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cinema_scrim"
            android:visibility="gone" />

        <TextView
            android:id="@+id/placeholderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/play_placeholder"
            android:textColor="@color/cinema_text_primary"
            android:textSize="15sp"
            android:visibility="visible" />

        <!-- IU not-generated overlay: shown when the selected IU / scene is not generated yet -->
        <TextView
            android:id="@+id/iuMissingOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp"
            android:background="@color/cinema_missing_bg"
            android:visibility="gone"
            android:text="@string/iu_not_generated"
            android:textColor="@color/cinema_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <!-- Subtitle Layer — current unit text overlay -->
        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:paddingBottom="20dp"
            android:background="@color/subtitle_background"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="sans-serif"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- Fullscreen Toggle Button - bottom right, player style -->
        <ImageButton
            android:id="@+id/fullscreenButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="14dp"
            android:background="@drawable/bg_player_control"
            android:contentDescription="@string/play_fullscreen"
            android:scaleType="center"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_fullscreen"
            app:tint="#FFFFFF" />

    </FrameLayout>

    <!-- Layer Controls — cinema console -->
    <HorizontalScrollView
        android:id="@+id/layerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toTopOf="@id/playButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.chip.Chip
                android:id="@+id/layerAudio"
                style="@style/Widget.Animastor.Chip.Layer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:checked="true"
                android:text=""
                android:contentDescription="@string/layer_audio"
                app:chipIcon="@drawable/ic_volume_up"
                app:chipIconVisible="true"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/layerImage"
                style="@style/Widget.Animastor.Chip.Layer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:checked="true"
                android:text=""
                android:contentDescription="@string/layer_image"
                app:chipIcon="@drawable/ic_image"
                app:chipIconVisible="true"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/layerVideo"
                style="@style/Widget.Animastor.Chip.Layer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:checked="true"
                android:text=""
                android:contentDescription="@string/layer_video"
                app:chipIcon="@drawable/ic_videocam"
                app:chipIconVisible="true"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/layerSubtitles"
                style="@style/Widget.Animastor.Chip.Layer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="true"
                android:text=""
                android:contentDescription="@string/layer_subtitles"
                app:chipIcon="@drawable/ic_subtitles"
                app:chipIconVisible="true"
                app:checkedIconVisible="false" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Play / Generate Button — big velvet play button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/playButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/play_play"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="18dp"
        app:icon="@drawable/ic_play"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:trackColor="?attr/colorOutlineVariant"
        app:indicatorColor="?attr/colorSecondary"
        app:layout_constraintBottom_toTopOf="@id/playButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/playButton"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
