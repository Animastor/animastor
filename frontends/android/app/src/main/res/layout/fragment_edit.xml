<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Position info bar — tappable to open Navigate -->
    <include
        android:id="@+id/positionBar"
        layout="@layout/include_position_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Unit carousel panel (collapsible — web parity: thin title strip when
         collapsed, chevron button floating top-right when expanded) -->
    <FrameLayout
        android:id="@+id/carouselContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/positionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Collapsed strip — title + chevron, tap to expand -->
        <LinearLayout
            android:id="@+id/carouselStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="10dp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_edit_strip"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/edit_carousel_title"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="?attr/colorOnSurfaceVariant"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Collapse chevron — floating top-right while expanded -->            <ImageButton
                android:id="@+id/carouselCollapseButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_collapse_btn"
                android:src="@drawable/ic_chevron_up"
                android:contentDescription="@string/edit_collapse"
                android:scaleType="center"
                android:padding="4dp" />

        <LinearLayout
            android:id="@+id/carouselRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:clipChildren="false">

            <!-- Previous unit thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/prevUnitCard"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceDim"
                android:visibility="invisible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/prevUnitImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/prevIuLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:background="#66000000"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:paddingVertical="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Current unit (larger) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/currentUnitCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                android:layout_marginHorizontal="10dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/currentUnitImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/currentIuLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:background="#66000000"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:paddingVertical="2dp"
                        android:fontFamily="sans-serif-medium" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Next unit thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nextUnitCard"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceDim"
                android:visibility="invisible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/nextUnitImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/nextIuLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:background="#66000000"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:paddingVertical="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </FrameLayout>

    <!-- Audio Timeline Panel (collapsible — web parity) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/timelinePanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/carouselContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Collapsed strip — title + chevron, tap to expand -->
            <LinearLayout
                android:id="@+id/timelineStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="10dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_edit_strip"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/edit_waveform_title"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Collapse chevron — floating top-right while expanded -->
            <ImageButton
                android:id="@+id/timelineCollapseButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_collapse_btn"
                android:src="@drawable/ic_chevron_up"
                android:contentDescription="@string/edit_collapse"
                android:scaleType="center"
                android:padding="4dp" />

            <LinearLayout
                android:id="@+id/timelineRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/timelinePlayButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@string/timeline_play"
                    android:tint="?attr/colorSecondary"
                    android:scaleType="fitCenter"
                    android:padding="8dp" />

                <com.example.animastor.ui.WaveformView
                    android:id="@+id/timelineWaveform"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp" />

                <ImageButton
                    android:id="@+id/timelineResetButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_reset"
                    android:contentDescription="@string/timeline_reset"
                    android:tint="?attr/colorSecondary"
                    android:scaleType="fitCenter"
                    android:padding="8dp" />

            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Section tabs with scroll indicators -->
    <!-- FrameLayout with background serves as the seamless panel.
         LinearLayout inside has transparent background — any transient gap
         between its children shows the FrameLayout's background (same color),
         making the gap invisible. No separate background View needed. -->
    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/timelinePanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/tabScrollLeft"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="Scroll left"
                android:scaleType="center"
                android:tint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/propertyTabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:tabMode="scrollable"
                app:tabGravity="fill"
                app:tabIndicatorHeight="2dp"
                app:tabIndicatorColor="?attr/colorSecondary"
                app:tabRippleColor="?attr/colorSecondaryContainer"
                app:tabTextAppearance="@style/TextAppearance.Material3.LabelLarge"
                app:tabTextColor="?attr/colorOnSurfaceVariant"
                app:tabSelectedTextColor="?attr/colorSecondary"
                app:tabBackground="?attr/colorSurfaceVariant">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_chapter_tab" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_scene" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_audio" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_units_tab" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_characters_tab" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_voices_tab" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_locations_tab" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_global_tab" />
            </com.google.android.material.tabs.TabLayout>

            <ImageButton
                android:id="@+id/tabScrollRight"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Scroll right"
                android:scaleType="center"
                android:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </FrameLayout>

    <!-- Content area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/tabContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- Floating "+" for the entity tables (characters/voices/locations) —
         overlays the content area's top-right corner; zero layout space, so
         the first card is never pushed down. Shown only on the entity tabs. -->
    <ImageButton
        android:id="@+id/entityAddButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_entity_add"
        android:src="@drawable/ic_add"
        android:tint="?attr/colorOnSecondary"
        android:contentDescription="@string/entity_add"
        android:scaleType="center"
        android:padding="6dp"
        android:elevation="2dp"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/contentScroll"
        app:layout_constraintEnd_toEndOf="@id/contentScroll" />

    <!-- Bottom row: SAVE -->
    <LinearLayout
        android:id="@+id/bottomRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/dirtyIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/edit_save"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnPrimary"
            style="@style/Widget.Material3.Button" />

    </LinearLayout>

    <!-- Dirty indicator -->
    <TextView
        android:id="@+id/dirtyIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:textColor="?attr/colorSecondary"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/errorText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty state: shown when no book is loaded -->
    <TextView
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/no_book_loaded"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Error message -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:visibility="gone"
        android:maxLines="3"
        android:ellipsize="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
