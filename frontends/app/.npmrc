# npm 10.9.8 arborist crashes with "TypeError: Cannot read properties of null (reading
# 'edgesOut')" during peer resolution for this tree; vitest@4 peer range (vite ^6||^7||^8)
# conflicts with the app's vite ^5.4.0, so peers must not be auto-installed here.
# Repo-local config keeps `npm install` and `npm ci` on the same resolution path.
legacy-peer-deps=true
