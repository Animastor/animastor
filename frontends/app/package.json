    "@animastor/web-workers": "file:../../packages/animastor-web-workers",
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0",
    "preact-router": "^4.1.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/preact": "^3.2.4",
    "happy-dom": "^20.14.0",
