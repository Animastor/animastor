{
  "name": "@animastor/web-generator-sse",
  "version": "0.1.0",
  "description": "SSE stream orchestration for Animastor generation progress. Manages the reconnect loop, epoch-guarded event routing, and error handling. The host owns the AbortController and SSE connection; this package consumes the stream and routes events through @animastor/web-generator.",
  "keywords": [
    "animastor",
    "generator",
    "sse",
    "stream",
    "reconnect",
    "progress",
    "preact",
    "web-ui",
    "frontend",
    "domain-logic",
    "ports-and-adapters"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@animastor/web-generator": "^0.1.0"
  },
  "devDependencies": {
    "happy-dom": "^20.14.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Animastor/animastor.git",
    "directory": "packages/animastor-web-generator-sse"
  },
  "homepage": "https://github.com/Animastor/animastor/tree/main/packages/animastor-web-generator-sse#readme",
  "bugs": {
    "url": "https://github.com/Animastor/animastor/issues"
  }
}
