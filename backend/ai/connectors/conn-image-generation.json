  },
  "compatibility": {
    "nodeClasses": {
      "108": "CLIPTextEncode",
      "109": "CLIPTextEncode",
      "110": "EmptySD3LatentImage",
      "120": "KSampler",
      "130": "VAEDecode",
      "1008": "SaveImage"
    }
  },
  "inputs": {
    "positivePrompt": {
      "nodeId": "108",
      "field": "inputs.text",
      "expectedClass": "CLIPTextEncode",
      "entityType": "positivePrompt",
      "label": "Positive Prompt",
      "required": true
    },
    "negativePrompt": {
      "nodeId": "109",
      "field": "inputs.text",
      "expectedClass": "CLIPTextEncode",
      "entityType": "negativePrompt",
      "label": "Negative Prompt",
      "required": true
    }
  },
  "outputs": {
    "generatedImage": {
      "nodeId": "1008",
      "field": "inputs.images",
      "expectedClass": "SaveImage",
      "entityType": "generatedImage",
      "label": "Generated Image"
    }
  },
  "parameters": {
    "width": {
      "nodeId": "110",
      "field": "inputs.width",
      "expectedClass": "EmptySD3LatentImage",
      "entityType": "width",
      "label": "Width",
      "default": 768,
      "min": 256,
      "max": 2048
    },
    "height": {
      "nodeId": "110",
      "field": "inputs.height",
      "expectedClass": "EmptySD3LatentImage",
      "entityType": "height",
      "label": "Height",
      "default": 1024,
      "min": 256,
      "max": 2048
    },
    "steps": {
      "nodeId": "120",
      "field": "inputs.steps",
      "expectedClass": "KSampler",
      "entityType": "steps",
      "label": "Steps",
      "default": 8,
