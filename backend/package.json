{
  "name": "animastor-backend",
  "version": "0.1.0",
  "description": "Animastor backend",
  "main": "src/backend.cjs",
  "bin": {
    "animastor-installer": "src/installer/cli.js"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node src/backend.cjs",
    "test": "mocha --exit tests/**/*.test.js",
    "test:arch": "mocha --exit tests/architecture/*.test.js",
    "test:connector-core": "cd ../packages/animastor-comfyui-workflow-connector && npm test",
    "test:coverage": "nyc --reporter=html --reporter=text mocha --exit tests/**/*.test.js",
    "test:syntax": "bash ../scripts/syntax-smoke.sh",
    "pretest": "bash ../scripts/syntax-smoke.sh"
  },
  "dependencies": {
    "@animastor/ai-agent": "file:../packages/animastor-ai-agent",
    "@animastor/ai-analysis": "file:../packages/animastor-ai-analysis",
    "@animastor/editor": "file:../packages/animastor-editor",
    "@animastor/parser": "file:../packages/animastor-parser",
    "@animastor/player": "file:../packages/animastor-player",
    "@animastor/vbook-runtime": "file:../packages/animastor-vbook-runtime",
    "adm-zip": "^0.5.10",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.0",
    "multer": "^2.2.0",
    "music-metadata": "^11.12.3",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.33.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "proxyquire": "^2.1.3"
  }
}
