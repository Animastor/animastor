# Animastor — environment secrets (copy to .env and fill in real values)
# .env is gitignored; never commit real secrets.

# PostgreSQL password (used by both the postgres container and the backend)
POSTGRES_PASSWORD=change_me

# OpenRouter / AI provider API key — GLOBAL FALLBACK ONLY (Experimental Beta).
# Each workspace can now store its own provider; set this only if you want the
# legacy deployment-wide default. Leave empty to rely on workspace providers.
OPENROUTER_API_KEY=sk-your-key-here

# Workspace AI provider secret-store key (REQUIRED, 32+ random chars).
# Encrypts per-workspace API keys at rest (AES-256-GCM) — never logged.
WORKSPACE_SECRET_KEY=change_me_32_or_more_random_chars

# Shared secret for backend -> GPU Hub task submission and queue administration.
# MUST match in backend and gpu-hub sections of docker-compose.yml.
# Empty value = open access (dev only — set a real key for production).
GPU_HUB_API_KEY=change_me

# GPU Hub — hard timeout for a single GPU task (worker death detection).
# INVARIANT: must be LESS than minimum backend dispatch-lease TTL
# (15 min by default; see backend/src/config/runtime-config.js LEASE_TTL_S).
# Default: 600000 ms = 10 min.
GPU_TIMEOUT=600000

# TEMPORARY (research): keep source audio chunks after merge instead of deleting
# them, so their real durations can be measured. Set to 1 while investigating
# audio/video sync, then remove.
KEEP_AUDIO_CHUNKS=1

# TEMPORARY (research): use tail-only cleanup (trim trailing silence only, keep
# internal pauses) and write real chunk durations to <scene>.chunk-durations.json
# before merge. Set to 1 while investigating audio/video sync, then remove.
AUDIO_CLEANUP_TAIL_ONLY=1
TRACK_CHUNK_DURATIONS=1

# ──────────────────────────────────────────────────────────────────────────
# DEPLOYMENT CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────
# TLS certificate directory (Let's Encrypt).
# Default: /etc/letsencrypt — standard certbot layout on Ubuntu.
# A fresh deployment must obtain certificates before starting HTTPS.
# Example: LETSENCRYPT_DIR=/etc/letsencrypt
LETS_ENCRYPT_DIR=/etc/letsencrypt

# ──────────────────────────────────────────────────────────────────────────
# PRIVATE WORKER (Experimental Beta) — GPU box configuration.
# These variables are read by worker/worker/worker.cjs on the WORKER MACHINE
# (not by docker-compose). Copy this block into worker/worker/.env on the GPU
# box, or export them before `node worker.cjs` / `./start-worker.sh`.
# See worker/worker/.env.example and docs/architecture/EXPERIMENTAL_BETA_WORKER_SETUP.md.
# ──────────────────────────────────────────────────────────────────────────
# GPU Hub base URL (your deployment origin + /gpu).
HUB_URL=https://your-animastor-host/gpu
# Private Worker credential — shown ONCE in Settings → Private Workers.
# Placeholder only; never commit a real credential.
ANIMASTOR_WORKER_TOKEN=wrk.your-worker-id.your-secret
# Worker type: image | audio | video.
WORKER_TYPE=image
# Worker label.
WORKER_ID=my-private-worker

