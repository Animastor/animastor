<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceDim">

    <!-- Standard position bar like other screens -->
    <include
        android:id="@+id/positionBar"
        layout="@layout/include_position_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- ════════════════════════════════════════════════
                 GLOBAL SECTION — Generate All + Stop All
                 ════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                style="@style/Widget.Animastor.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/generate_global_section"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/generateAllButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/generate_all"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined"
                            app:strokeWidth="3dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconTint="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stopAllButton"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:minWidth="120dp"
                            android:text="@string/stop_all"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined.Error"
                            app:icon="@drawable/ic_stop"
                            app:iconGravity="textStart"
                            app:iconTint="@color/cinema_error" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════
                 VBOOK AGENTS SECTION
                 ════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/vbookSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                style="@style/Widget.Animastor.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header: icon + label + switch -->
                    <LinearLayout
                        android:id="@+id/vbookHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/vbookIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_library"
                            android:tint="?attr/colorSecondary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/vbookLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:singleLine="true" />

                        <!-- ⚙ Settings placeholder — visible in future -->
                        <ImageButton
                            android:id="@+id/vbookSettingsButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_settings"
                            android:contentDescription="@string/settings_title"
                            android:tint="?attr/colorOnSurfaceVariant"
                            android:visibility="visible" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/vbookSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp" />
                    </LinearLayout>

                    <!-- Progress rows container -->
                    <LinearLayout
                        android:id="@+id/vbookProgressList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                    <!-- Action buttons -->
                    <LinearLayout
                        android:id="@+id/vbookButtonsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/generateVBookButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/generate_vbook"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined"
                            app:strokeWidth="3dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconTint="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stopVBookButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:minWidth="96dp"
                            android:text="@string/generate_stop"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined.Error"
                            app:icon="@drawable/ic_stop"
                            app:iconGravity="textStart"
                            app:iconTint="@color/cinema_error" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════
                 AUDIO WORKERS SECTION
                 ════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/audioSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                style="@style/Widget.Animastor.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header: icon + label + switch -->
                    <LinearLayout
                        android:id="@+id/audioHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/audioIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_volume_up"
                            android:tint="?attr/colorSecondary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/audioLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:singleLine="true" />

                        <!-- ⚙ Settings placeholder — visible in future -->
                        <ImageButton
                            android:id="@+id/audioSettingsButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_settings"
                            android:contentDescription="@string/settings_title"
                            android:tint="?attr/colorOnSurfaceVariant"
                            android:visibility="visible" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/audioSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp" />
                    </LinearLayout>

                    <!-- Progress rows container -->
                    <LinearLayout
                        android:id="@+id/audioProgressList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                    <!-- Action buttons -->
                    <LinearLayout
                        android:id="@+id/audioButtonsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/generateAudioButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/generate_audio"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined"
                            app:strokeWidth="3dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconTint="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stopAudioButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:minWidth="96dp"
                            android:text="@string/generate_stop"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined.Error"
                            app:icon="@drawable/ic_stop"
                            app:iconGravity="textStart"
                            app:iconTint="@color/cinema_error" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════
                 IMAGE WORKERS SECTION
                 ════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imageSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                style="@style/Widget.Animastor.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header: icon + label + switch -->
                    <LinearLayout
                        android:id="@+id/imageHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/imageIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_image"
                            android:tint="?attr/colorSecondary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/imageLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:singleLine="true" />

                        <!-- ⚙ Settings placeholder — visible in future -->
                        <ImageButton
                            android:id="@+id/imageSettingsButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_settings"
                            android:contentDescription="@string/settings_title"
                            android:tint="?attr/colorOnSurfaceVariant"
                            android:visibility="visible" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/imageSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp" />
                    </LinearLayout>

                    <!-- Progress rows container -->
                    <LinearLayout
                        android:id="@+id/imageProgressList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                    <!-- Action buttons -->
                    <LinearLayout
                        android:id="@+id/imageButtonsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/generateImageButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/generate_images"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined"
                            app:strokeWidth="3dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconTint="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stopImageButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:minWidth="96dp"
                            android:text="@string/generate_stop"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined.Error"
                            app:icon="@drawable/ic_stop"
                            app:iconGravity="textStart"
                            app:iconTint="@color/cinema_error" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════
                 VIDEO WORKERS SECTION
                 ════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/videoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                style="@style/Widget.Animastor.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header: icon + label + switch -->
                    <LinearLayout
                        android:id="@+id/videoHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/videoIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_videocam"
                            android:tint="?attr/colorSecondary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/videoLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:singleLine="true" />

                        <!-- ⚙ Settings placeholder — visible in future -->
                        <ImageButton
                            android:id="@+id/videoSettingsButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_settings"
                            android:contentDescription="@string/settings_title"
                            android:tint="?attr/colorOnSurfaceVariant"
                            android:visibility="visible" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/videoSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp" />
                    </LinearLayout>

                    <!-- Progress rows container -->
                    <LinearLayout
                        android:id="@+id/videoProgressList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                    <!-- Action buttons -->
                    <LinearLayout
                        android:id="@+id/videoButtonsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/generateVideoButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/generate_video"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined"
                            app:strokeWidth="3dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconTint="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stopVideoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:minWidth="96dp"
                            android:text="@string/generate_stop"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            style="@style/Widget.Animastor.Button.Outlined.Error"
                            app:icon="@drawable/ic_stop"
                            app:iconGravity="textStart"
                            app:iconTint="@color/cinema_error" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
