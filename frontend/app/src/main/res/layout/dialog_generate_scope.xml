<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/dialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/scopeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/scopeWholeBook"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textSize="14sp"
            android:text="@string/scope_whole_book" />

        <RadioButton
            android:id="@+id/scopeCurrentChapter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textSize="14sp"
            android:text="@string/scope_current_chapter" />

        <RadioButton
            android:id="@+id/scopeCurrentScene"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textSize="14sp"
            android:text="@string/scope_current_scene" />
    </RadioGroup>

</LinearLayout>
