<?xml version="1.0" encoding="utf-8"?>
<!--
    Ripple foreground for worker panel header rows.
    Uses a rounded mask (12dp) matching the panel background so the
    click feedback respects the rounded corners instead of flashing
    a rectangular highlight.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorOnSurface">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/cinema_text_primary" />
        </shape>
    </item>
</ripple>
